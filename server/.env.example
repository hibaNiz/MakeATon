# Copy this file to ".env" and fill in your own values.
# Local PostgreSQL connection: postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop"
JWT_SECRET="change-me-to-any-long-random-string"
PORT=4000
CLIENT_URL="http://localhost:5173"

# Optional: real email for password reset (e.g. Gmail with an App Password).
# If left empty, the reset link is printed in the server terminal instead (works offline).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Brightloop <no-reply@brightloop.local>"

# Run the automatic billing job every N minutes (0 = off, use the "Run billing" button)
BILLING_INTERVAL_MINUTES=60
