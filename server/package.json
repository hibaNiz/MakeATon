{
  "name": "brightloop-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:setup": "node db/setup.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/setup.js && node db/seed.js",
